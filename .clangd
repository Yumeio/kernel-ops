# clangd configuration (VS Code: llvm-vs-code-extensions.vscode-clangd).
#
# clangd reads build-clangd/compile_commands.json. It is generated, never
# committed (build*/ is ignored):
#
#   cmake --preset dev                 -> build/dev/compile_commands.json
#   python tools/gen_clangd_db.py      -> build-clangd/compile_commands.json
#
# The generator rewrites CMake's nvcc command lines for clang and adds one
# command per library header, whose force-included prelude carries that header's
# transitive `Requires:` closure (the headers contain no #include by design).
# Re-run it after configuring another preset, or after adding/moving headers.
CompileFlags:
  CompilationDatabase: build-clangd

Completion:
  # CUDA/PyTorch headers can depend on include order.
  HeaderInsertion: Never

Diagnostics:
  # CUDA wrappers and dispatch macros make include-cleaner suggestions unreliable.
  UnusedIncludes: None
  MissingIncludes: None

---
# Generated databases, reference checkouts and tool caches are not worth
# indexing. PathMatch is a regex over the absolute path ('\' on Windows), so
# these patterns key off path components only.
If:
  PathMatch: '.*(build|3rd|clangd|ninja|ccache).*'
Index:
  Background: Skip
